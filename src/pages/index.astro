---
import "../styles/global.css";
import articles from "../../data/articles.json";

type ArticleSummary = {
  slug: string;
  title: string;
  author?: string;
  date?: string | null;
  sourceUrl?: string;
  status?: string;
  excerpt?: string;
  image?: string;
  cardImage?: string;
};

const typedArticles = articles as ArticleSummary[];
const sortedArticles = [...typedArticles].sort((a, b) => {
  const left = a.date ? new Date(a.date).valueOf() : 0;
  const right = b.date ? new Date(b.date).valueOf() : 0;
  return right - left;
});

const formatter = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Medium 编辑精选的改写式中文翻译与发芽笔记归档。" />
    <title>Medium 编辑精选 · 中文翻译与发芽</title>
  </head>
  <body>
    <header class="topbar">
      <div class="shell topbar-inner">
        <a class="brand" href="/">
          <span class="brand-mark">M</span>
          <span>Medium 编辑精选 · 中文翻译与发芽</span>
        </a>
        <nav class="nav" aria-label="Primary">
          <span>Medium 编辑精选</span>
          <a href="https://medium.com/edit-suggestion" rel="noreferrer">Selected by Medium</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="shell hero">
        <h1>Medium 编辑精选的中文工作台：每日 Selected by Medium 与 Staff Picks 的改写式翻译与发芽笔记</h1>
        <p>
          每天从 Medium 官方编辑精选（Selected by Medium 与 Staff Picks）中挑选文章，沉淀两份材料：一份忠实的改写式中文翻译，一份材料驱动的发芽笔记。
        </p>
        <div class="meta-strip" aria-label="Site stats">
          <span class="pill">{sortedArticles.length} 篇文章</span>
          <span class="pill">跳过锁定文章</span>
          <span class="pill">GitHub Pages 部署</span>
        </div>
      </section>

      <section class="shell list" aria-label="Articles">
        {
          sortedArticles.length === 0 ? (
            <div class="empty">
              还没有处理完成的文章。每日 08:00 自动化会从编辑精选发现并处理新文章。
              生成第一批内容，或使用 <code>--processor openai</code> 直接生成两份文稿。
            </div>
          ) : (
            sortedArticles.map((article) => (
              <article class="article-row">
                <div>
                  <h2>
                    <a href={`/articles/${article.slug}/`}>{article.title}</a>
                  </h2>
                  {article.excerpt && <p>{article.excerpt}</p>}
                  <div class="article-meta">
                    <span>{article.author || "Medium"}</span>
                    {article.date && <span>{formatter.format(new Date(article.date))}</span>}
                    <span>{article.status}</span>
                    {article.sourceUrl && (
                      <a href={article.sourceUrl} rel="noreferrer">原文</a>
                    )}
                  </div>
                </div>
                <a class="thumb" href={`/articles/${article.slug}/`} aria-label={article.title}>
                  {(article.cardImage || article.image) && (
                    <img
                      src={article.cardImage || article.image}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="180"
                      height="132"
                    />
                  )}
                </a>
              </article>
            ))
          )
        }
      </section>
    </main>
  </body>
</html>
